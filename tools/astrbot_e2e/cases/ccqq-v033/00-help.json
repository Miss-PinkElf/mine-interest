{
  "name": "cc-qq /help 命令列表",
  "plugin": "astrbot_plugin_cc_qq",
  "send": {
    "group_id": "{{group_id}}",
    "text": "/help",
    "at_bot": true
  },
  "expect": {
    "timeout_seconds": 60,
    "messages": [
      {"contains": ["/start", "/info", "/pwd"]}
    ],
    "images": {"max": 0}
  }
}
