{
  "name": "cc_qq /help 命令列表",
  "plugin": "astrbot_plugin_cc_qq",
  "reload": true,
  "send": {
    "group_id": "{{group_id}}",
    "text": "/help",
    "at_bot": true
  },
  "expect": {
    "timeout_seconds": 30,
    "messages": [{"contains": ["/start", "/info"]}],
    "images": {"max": 0},
    "semantic": {
      "enabled": true,
      "criteria": "回复是一份命令列表，且包含 /start 与 /info，不包含 /new"
    }
  }
}
