{
  "name": "cc_qq /help 群聊回执",
  "plugin": "astrbot_plugin_cc_qq",
  "reload": true,
  "send": {
    "group_id": "{{group_id}}",
    "text": "/help",
    "at_bot": true
  },
  "expect": {
    "timeout_seconds": 30,
    "messages": [{"contains": ["/new", "/info"]}],
    "semantic": {
      "enabled": true,
      "criteria": "回复是一份命令列表，且包含 /new 与 /info"
    }
  }
}
