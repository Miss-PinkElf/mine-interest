# Docker 双容器 E2E 本地覆盖示例
#
# 使用方式：
#   cp tools/napcat_e2e/.env.example tools/napcat_e2e/.env
#   按需修改后，start-*.sh 会自动 source 本目录的 .env
#
# 注意：
#   - .env 已在 .gitignore 中忽略，不要提交真实 token。
#   - 不填也能运行，common.sh 里有本地测试默认值。

# 运行数据目录（QQ 登录态、NapCat 配置），必须在仓库外。
E2E_ROOT=${HOME}/.qq-e2e-docker

# 测试账号
BOT_QQ=3254276668
SENDER_QQ=1961618848

# OneBot token：必须与 tools/astrbot_e2e/config.local.json 一致
BOT_WS_TOKEN=e2e-bot-token
SENDER_WS_TOKEN=e2e-sender-token
REVERSE_WS_TOKEN=e2e-reverse-token

# NapCat WebUI token（仅 127.0.0.1 可访问）
BOT_WEBUI_TOKEN=e2e-bot-webui
SENDER_WEBUI_TOKEN=e2e-sender-webui

# 默认加载的测试插件（可被 --plugin 覆盖）
E2E_PLUGIN=astrbot_plugin_cc_qq
