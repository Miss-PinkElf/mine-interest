# 与本 skill 同级；复制为 .env 后填写
# cp .env.example .env
# Windows: copy .env.example .env

# ============================================================
# 方式 A：单 key（最简单，向后兼容）
# ============================================================
RC_API_KEY=你的rightcode key填这里
RC_BASE_URL=https://rightapi.ai

# ============================================================
# 方式 B：多 key / 多平台档案
# 配置了任意 RC_PROFILE_<SLUG>_* 后，可用 --profile 选择；
# 不指定时使用 RC_DEFAULT_PROFILE，未设置则使用第一个档案。
# 全局 RC_API_KEY / RC_BASE_URL / RC_MODEL 仍作为档案缺省值的回退。
# 查看档案：run.sh --list-profiles
# ============================================================
# 默认档案用「Image」；需要高质量分组时显式 -p IMAGE_HIGH
# RC_DEFAULT_PROFILE=IMAGE
#
# RC_PROFILE_IMAGE_NAME=Image
# RC_PROFILE_IMAGE_BASE_URL=https://rightapi.ai
# RC_PROFILE_IMAGE_KEY=sk-...
# RC_PROFILE_IMAGE_MODEL=gpt-image-2
# RC_PROFILE_IMAGE_MODELS=gpt-image-2,gpt-image-2-vip,gpt-image-2.5
# RC_PROFILE_IMAGE_ALIASES=
#
# RC_PROFILE_IMAGE_HIGH_NAME=Image 高质量
# RC_PROFILE_IMAGE_HIGH_BASE_URL=https://rightapi.ai
# RC_PROFILE_IMAGE_HIGH_KEY=sk-...
# RC_PROFILE_IMAGE_HIGH_MODEL=gpt-image-2
# RC_PROFILE_IMAGE_HIGH_MODELS=gpt-image-2,gpt-image-2.5-flare,gemini-3-pro-image-preview
# 别名覆盖：模型:协议，逗号分隔；协议只能是 openai / gemini
# RC_PROFILE_IMAGE_HIGH_ALIASES=nano-banana-pro:gemini

# 默认模型：gpt-image-2（基础模型，兼容性最稳）
# 速度优先：gpt-image-2.5-flare
# 高质量编辑：gpt-image-2.5-sunburst
# Gemini 协议：gemini-3-pro-image-preview / gemini-nano-banana-2.1
RC_MODEL=gpt-image-2

# 可选默认值（CLI 参数可覆盖）
# RC_SIZE=1024x1024
# RC_QUALITY=auto
# RC_ASPECT_RATIO=1:1
# RC_IMAGE_SIZE=1K
# RC_OUTPUT_FORMAT=png
# RC_OUT_DIR=/绝对路径/gen-images

# 异步轮询：间隔 5 秒，整体上限 600 秒
# RC_POLL_INTERVAL=5
RC_TIMEOUT=600

# 提交请求超时（上传大参考图时可调大）
# RC_SUBMIT_TIMEOUT=180

# 设为 1 时忽略系统 HTTP(S)_PROXY 直连（等价 --no-proxy）
# RC_NO_PROXY=0
